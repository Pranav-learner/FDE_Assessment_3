# ==============================================================================
# AI Procurement Request Copilot — Environment Configuration
# ==============================================================================

# Vendor Risk Assessment Service Base URL
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# Operational LLM Mode: 'mock' (offline/deterministic) or 'live' (cloud provider)
LLM_MODE=mock

# Default Copilot Architecture: 'single' (Architecture A MVP) or 'staged' (Architecture B Escalation)
DEFAULT_ARCHITECTURE=single

# Provider Credentials (Required ONLY when LLM_MODE=live)
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# GOOGLE_API_KEY=your-gemini-api-key-here
# MODEL_NAME=gpt-4o

# Service Call Timeouts (Seconds)
LLM_TIMEOUT_SECONDS=15.0
VENDOR_API_TIMEOUT_SECONDS=5.0
